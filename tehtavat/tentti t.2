import random

lyhyin = ""
pisin = ""
laskuri = 0

while True:
    sana = input("Anna sana: ")

    if sana != "":
        laskuri += 1

        if len(sana) < len(lyhyin):
            sana = lyhyin
        elif len(sana) > len(pisin):
            pisin = sana
    
    if sana == "":
        break
print("Lyhin sana: ", lyhyin)
print("Pisin sana: ", pisin)
print("Sanoja yhteensä: ", laskuri)
